{
  "name": "Mettu · ringtone studio",
  "short_name": "Mettu",
  "description": "Cut the part of a song you love, level it, hear it ring, and set it as your ringtone. Everything stays on your phone.",
  "lang": "en",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f5f8",
  "theme_color": "#5a3ec8",
  "categories": ["music", "utilities"],
  "icons": [
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "audio", "accept": ["audio/*", "video/*", ".mp3", ".m4a", ".wav", ".ogg", ".opus", ".aac", ".flac", ".mp4"] }] }
  }
}
